{
  "version": "2.0.0",
  "tasks": [
    {
        "label": "启动后端",
        "type": "shell",
        "command": "dotnet watch run",
        "options": {
            "cwd": "${workspaceFolder}/backend"
        },
        "isBackground": true,
        "problemMatcher": "$msCompile"
    },
    {
        "label": "启动前端",
        "type": "shell",
        "command": "npm run dev",
        "options": {
            "cwd": "${workspaceFolder}/frontend"
        },
        "isBackground": true,
        "problemMatcher": []
    },
    {
        "label": "启动全部（前后端）",
        "dependsOn": [
            "启动后端",
            "启动前端"
        ],
        "problemMatcher": []
    }
]
}